# CareerLM environment variable template
# Never commit real credentials, private data, tokens, or secrets.

# PostgreSQL connection string used by CareerLM persistence and
# database-backed authentication.
#
# Never commit an actual password or connection string.
#
# Example format:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=

# Optional location for legacy CareerLM JSON persistence.
#
# If DATABASE_URL is not configured, career-data persistence can still
# use the JSON fallback. Registration/login require PostgreSQL.
#
# If omitted, legacy JSON persistence uses:
# .careerlm/data.json
CAREERLM_DATA_FILE=