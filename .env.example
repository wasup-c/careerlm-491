# CareerLM environment variable template
# Never commit real credentials, private data, tokens, or secrets.

# Explicit local/development CareerLM identity.
#
# This is a temporary integration boundary until a production
# authentication/session provider is implemented.
#
# Example:
# CAREERLM_USER_ID=local-user
CAREERLM_USER_ID=

# Optional location for CareerLM JSON persistence.
# If omitted, CareerLM stores local state in:
# .careerlm/data.json
CAREERLM_DATA_FILE=