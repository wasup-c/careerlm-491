# CareerLM environment variable template
# Never commit real credentials, private data, tokens, or secrets.

# Explicit local/development CareerLM identity.
#
# This is a temporary integration boundary until the database-backed
# authentication/session provider is implemented.
#
# Example:
# CAREERLM_USER_ID=local-user
CAREERLM_USER_ID=

# PostgreSQL connection string used by CareerLM persistence.
#
# Never commit an actual password or connection string.
#
# Example format:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=

# Optional location for legacy CareerLM JSON persistence.
#
# If DATABASE_URL is not configured, the current fallback repository can
# continue using local JSON persistence during the database migration.
#
# If omitted, CareerLM stores local JSON state in:
# .careerlm/data.json
CAREERLM_DATA_FILE=